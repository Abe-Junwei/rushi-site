---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DEFAULT_TREE_SAMPLE } from "../lib/treeTableize";
---

<BaseLayout
  title="树形文本转表格化视图 - 如是我闻"
  description="把以层级标记写成的树形文本，即时转换成可粘贴到 Word / WPS 的纯文本连接线图。"
>
  <section class="page-hero">
    <span class="eyebrow">工具</span>
    <h1>树形文本转表格化视图</h1>
    <p>
      左侧编辑以 <code>#</code> 标记层级的文本，右侧即时生成纯文本连接线图。复制后可贴进 Word、WPS 或其他编辑器。
    </p>
  </section>

  <section class="section-block tree-tool">
    <div class="tree-toolbar">
      <label class="tree-mark">
        <span>行首标记符</span>
        <input id="charMark" type="text" value="#" maxlength="1" />
      </label>
      <div class="tree-layout" role="group" aria-label="排版">
        <button class="tree-layout-btn" id="layoutCompact" type="button" data-layout="compact">紧凑</button>
        <button class="tree-layout-btn is-active" id="layoutWide" type="button" data-layout="wide">舒展</button>
      </div>
      <button class="button secondary" id="resetBtn" type="button">恢复示例</button>
    </div>
    <p class="tree-hint">
      粘贴到 Word / WPS：选中该段 → 字体设为「新宋体」或等宽中文字体 → 单倍行距 → 关闭自动换行。不要用微软雅黑。跳级标题会自动补层。
    </p>
    <p class="tree-status" id="treeStatus" hidden></p>

    <div class="tree-workspace">
      <section class="tree-pane">
        <div class="tree-pane-bar">
          <span>源文本</span>
        </div>
        <textarea id="inputText" rows="16">{DEFAULT_TREE_SAMPLE}</textarea>
      </section>

      <section class="tree-pane">
        <div class="tree-pane-bar">
          <span>预览 · 纯文本</span>
          <button class="button secondary" id="copyBtn" type="button">复制</button>
        </div>
        <pre id="output" class="tree-output"></pre>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import { convertTree, DEFAULT_TREE_SAMPLE, type TreeLayout } from "../lib/treeTableize";

  const DRAFT_KEY = "rushi.tree-tool.draft.v3";
  const RENDER_DELAY_MS = 80;
  const DEFAULT_LAYOUT: TreeLayout = "wide";

  const input = document.getElementById("inputText") as HTMLTextAreaElement;
  const mark = document.getElementById("charMark") as HTMLInputElement;
  const output = document.getElementById("output") as HTMLPreElement;
  const copyBtn = document.getElementById("copyBtn") as HTMLButtonElement;
  const resetBtn = document.getElementById("resetBtn") as HTMLButtonElement;
  const status = document.getElementById("treeStatus") as HTMLParagraphElement;
  const layoutButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-layout]")];

  let layout: TreeLayout = DEFAULT_LAYOUT;

  function debounce(fn: () => void, wait: number) {
    let timer = 0;
    const run = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(fn, wait);
    };
    run.flush = () => {
      window.clearTimeout(timer);
      fn();
    };
    return run as (() => void) & { flush: () => void };
  }

  function setLayout(next: TreeLayout) {
    layout = next;
    for (const button of layoutButtons) {
      button.classList.toggle("is-active", button.dataset.layout === next);
    }
  }

  function loadDraft() {
    try {
      const raw = localStorage.getItem(DRAFT_KEY);
      if (!raw) return null;
      const draft = JSON.parse(raw) as { text?: string; mark?: string; layout?: string };
      return {
        text: typeof draft.text === "string" ? draft.text : null,
        mark: typeof draft.mark === "string" && draft.mark ? draft.mark.slice(0, 1) : null,
        layout: draft.layout === "compact" || draft.layout === "wide" ? draft.layout : null,
      };
    } catch {
      return null;
    }
  }

  function saveDraft() {
    localStorage.setItem(
      DRAFT_KEY,
      JSON.stringify({ text: input.value, mark: mark.value || "#", layout }),
    );
  }

  function showStatus(warnings: string[]) {
    if (!warnings.length) {
      status.hidden = true;
      status.textContent = "";
      return;
    }
    status.hidden = false;
    status.textContent = warnings.join(" ");
  }

  function render() {
    saveDraft();
    const text = input.value;
    if (!text.trim()) {
      output.dataset.empty = "true";
      output.textContent = "输入层级文本后，预览会即时更新。";
      copyBtn.disabled = true;
      showStatus([]);
      return;
    }

    try {
      const result = convertTree(text, mark.value || "#", { layout });
      output.innerHTML = result.html;
      output.dataset.empty = "false";
      copyBtn.disabled = false;
      showStatus(result.warnings);
    } catch {
      output.dataset.empty = "true";
      output.textContent = "无法解析当前文本。请检查层级标记是否连续。";
      copyBtn.disabled = true;
      showStatus([]);
    }
  }

  const scheduleRender = debounce(render, RENDER_DELAY_MS);

  const draft = loadDraft();
  if (draft?.text != null) input.value = draft.text;
  if (draft?.mark) mark.value = draft.mark;
  setLayout(draft?.layout ?? DEFAULT_LAYOUT);

  input.addEventListener("input", scheduleRender);
  mark.addEventListener("input", scheduleRender);
  for (const button of layoutButtons) {
    button.addEventListener("click", () => {
      const next = button.dataset.layout;
      if (next !== "compact" && next !== "wide") return;
      setLayout(next);
      render();
    });
  }
  resetBtn.addEventListener("click", () => {
    input.value = DEFAULT_TREE_SAMPLE;
    mark.value = "#";
    setLayout(DEFAULT_LAYOUT);
    render();
  });
  copyBtn.addEventListener("click", async () => {
    scheduleRender.flush();
    if (copyBtn.disabled) return;
    const text = (output.textContent ?? "").replace(/\r?\n/g, "\r\n");
    try {
      await navigator.clipboard.writeText(text);
      const previous = copyBtn.textContent;
      copyBtn.textContent = "已复制";
      window.setTimeout(() => {
        copyBtn.textContent = previous;
      }, 1600);
    } catch {
      copyBtn.textContent = "复制失败";
    }
  });

  render();
</script>
