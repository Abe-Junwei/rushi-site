---
import DownloadCards from "../components/DownloadCards.astro";
import ProductPreview from "../components/ProductPreview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { guideSteps, productFaq, productUseCases, version } from "../data";

const capabilities = [
  {
    number: "01",
    title: "本机转写",
    body: "内置 FunASR 本机模型。模型就绪后可断网转写；需要在线服务时，再按需配置 STT Provider。",
    detail: "录音与项目默认留在你的电脑上。",
    href: "/docs/features/local-asr",
    link: "了解本机转写",
  },
  {
    number: "02",
    title: "波形校对",
    body: "把波形、播放头和语段放在同一工作区。边听边定位，按需要拆分、合并和精修。",
    detail: "听到哪里，文字就校到哪里。",
    href: "/docs/features/waveform-review",
    link: "了解波形校对",
  },
  {
    number: "03",
    title: "交付导出",
    body: "从语段到成稿，按用途导出 TXT、SRT 或 DOCX。场次信息可随文档一起交付。",
    detail: "一份录音，整理成可用的文字。",
    href: "/docs/getting-started",
    link: "查看完整流程",
  },
] as const;

const changeModules = import.meta.glob("../../changes/*.md", { eager: true });
const recentChanges = (Object.values(changeModules) as Array<{ frontmatter: Record<string, string> }>)
  .sort((a, b) => String(b.frontmatter.date).localeCompare(String(a.frontmatter.date)))
  .slice(0, 3);
---

<BaseLayout>
  <section class="home-hero">
    <div class="home-hero-copy">
      <span class="eyebrow">如是我闻 · Rushi</span>
      <h1>让每一段录音<br />成为可交付的文字</h1>
      <p>本机转写、波形校对、智能改稿与文稿导出，在一个桌面工作区里完成。</p>
      <div class="home-actions">
        <a class="button primary" href="#download">下载桌面版 <span aria-hidden="true">↗</span></a>
        <a class="button secondary" href="/features">了解功能 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <ProductPreview />
  </section>

  <section class="trust-band" aria-label="产品原则">
    <span class="eyebrow">从录音到文稿</span>
    <p>为中文长音频而做。<strong>项目数据默认保存在本机</strong>，在线转写由你按需开启。</p>
    <a href="/docs/getting-started">看看如何开始 <span aria-hidden="true">↗</span></a>
  </section>

  <section class="home-statement">
    <div class="home-statement-inner">
      <span class="eyebrow">一个连贯的工作区</span>
      <h2>听、看、改、交付，<br />不必在工具之间来回切换。</h2>
      <p>从项目里的原始音频出发，在时间轴上找到每一句话，逐步整理成可复用的文字材料。</p>
    </div>
  </section>

  <section class="capability-stack" id="features" aria-labelledby="capability-heading">
    <div class="home-section-heading">
      <span class="eyebrow">核心能力</span>
      <h2 id="capability-heading">把漫长的整理过程，<br />放进清晰的步骤里。</h2>
    </div>
    {capabilities.map((item) => (
      <article class="capability-row">
        <div class="capability-copy">
          <span class="capability-eyebrow">{item.number} / 03</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <a href={item.href}>{item.link} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="capability-visual">
          {item.number === "02" ? (
            <img src="/rushi-editor-demo.png" alt="真实编辑器中的波形和校对语段" width="2560" height="1600" loading="lazy" />
          ) : (
            <div class="capability-typographic">
              <span>{item.number === "01" ? "LOCAL TRANSCRIPTION" : "READY TO DELIVER"}</span>
              <strong>{item.detail}</strong>
              {item.number === "03" && <small>TXT&nbsp;&nbsp;/&nbsp;&nbsp;SRT&nbsp;&nbsp;/&nbsp;&nbsp;DOCX</small>}
            </div>
          )}
        </div>
      </article>
    ))}
  </section>

  <section class="scene-workflow">
    <div class="scene-workflow-grid">
      <div>
        <span class="eyebrow">适用场景</span>
        <h2>不止一种录音，<br />也不止一种成稿。</h2>
        <ul class="scene-list">
          {productUseCases.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{item.title}</h3><p>{item.description}</p></div>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <span class="eyebrow">使用流程</span>
        <h2>四步，从音频<br />走到可以交付。</h2>
        <ol class="workflow-list">
          {guideSteps.map((item) => (
            <li>
              <span>{item.step}</span>
              <div><h3>{item.title}</h3><p>{item.body}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {recentChanges.length > 0 && (
    <section class="home-releases">
      <div class="home-section-heading">
        <span class="eyebrow">最近更新</span>
        <h2>产品持续打磨。</h2>
        <a href="/changelog">查看全部更新 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="home-release-list">
        {recentChanges.map((change) => (
          <a href="/changelog">
            <time>{new Date(change.frontmatter.date).toISOString().slice(0, 10)}</time>
            <strong>{change.frontmatter.title}</strong>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="home-faq" aria-labelledby="faq-heading">
    <div class="home-faq-inner">
      <div>
        <span class="eyebrow">常见问题</span>
        <h2 id="faq-heading">开始之前，<br />你可能想知道。</h2>
      </div>
      <div class="home-faq-list">
        {productFaq.map((item) => (
          <details>
            <summary>{item.question}<span aria-hidden="true">＋</span></summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="home-download" id="download">
    <div class="home-download-heading">
      <span class="eyebrow">开始使用</span>
      <h2>让下一份录音，<br />更快变成文稿。</h2>
      <p>桌面版支持 macOS Apple Silicon 与 Windows x64。</p>
    </div>
    <DownloadCards />
    <p class="home-download-note">当前公开版本 v{version} · <a href="/download">查看安装说明与其他下载</a></p>
  </section>
</BaseLayout>
