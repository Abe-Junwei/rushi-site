---
import "../styles/site.css";
import "../styles/home.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "如是我闻 Rushi - 本地中文课录音转写与校对",
  description = "如是我闻 Rushi 是本地中文录音转写与校对桌面应用，支持本机 ASR、波形校对、智能改稿、TXT/SRT/DOCX 导出与 macOS、Windows 下载。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Noto+Serif+SC:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand-link" href="/" aria-label="如是我闻首页">
        <img src="/rushi-lockup.png" alt="" width="32" height="32" />
        <span>如是我闻</span>
      </a>
      <nav class="main-nav" aria-label="主导航">
        <a href="/features">功能</a>
        <a href="/docs/getting-started">使用说明</a>
        <a href="/changelog">更新记录</a>
        <a href="/download">下载</a>
      </nav>
      <a class="header-cta" href="/download">获取应用 <span aria-hidden="true">↗</span></a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-brand">
        <strong>如是我闻</strong>
        <span>让每一段录音成为可交付的文字。</span>
      </div>
      <div class="footer-links">
        <div>
          <strong>产品</strong>
          <a href="/features">功能介绍</a>
          <a href="/download">下载应用</a>
          <a href="/changelog">更新记录</a>
        </div>
        <div>
          <strong>帮助</strong>
          <a href="/docs/getting-started">使用说明</a>
          <a href="/docs/features/local-asr">本机转写</a>
          <a href="/docs/features/waveform-review">波形校对</a>
        </div>
        <div>
          <strong>更多</strong>
          <a href="/tree">义脉树枝图生成器</a>
        </div>
      </div>
      <p>Copyright © 沂南灵创技术服务中心。当前无 Linux 桌面包。</p>
    </footer>
  </body>
</html>
